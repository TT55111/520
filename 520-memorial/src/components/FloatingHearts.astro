---
// 漂浮粒子背景组件
// 从爱心中心向外飘散的粒子效果
---

<div id="particles" class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
</div>

<script is:inline>
  (function () {
    const container = document.getElementById("particles");
    if (!container) return;

    const colors = [
      "rgba(237,107,134,0.4)",
      "rgba(237,107,134,0.3)",
      "rgba(245,168,184,0.4)",
      "rgba(212,80,122,0.3)"
    ];
    const particleCount = 30;

    // 爱心 SVG 路径，用于约 35% 的粒子
    const heartSVG = '<svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M462.3 62.6C407.5 15.9 326 24.3 275.7 76.2L256 96.5l-19.7-20.3C186.1 24.3 104.5 15.9 49.7 62.6c-62.8 53.6-66.1 149.8-9.9 207.9l193.5 199.8c12.5 12.9 32.8 12.9 45.3 0l193.5-199.8c56.3-58.1 53-154.3-9.8-207.9z"/></svg>';

    function createParticle() {
      const p = document.createElement("div");
      const isHeart = Math.random() > 0.65;
      const size = Math.random() * 6 + 3;
      const color = colors[Math.floor(Math.random() * colors.length)];

      if (isHeart) {
        p.innerHTML = heartSVG;
        p.style.cssText = `
          position: absolute;
          width: ${size * 1.5}px;
          height: ${size * 1.5}px;
          left: 50%;
          top: 50%;
          opacity: 0;
          --dx: ${(Math.random() - 0.5) * 600}px;
          --dy: ${(Math.random() - 0.5) * 600}px;
          --rot: ${(Math.random() - 0.5) * 360}deg;
          animation: particleDrift ${Math.random() * 6 + 7}s linear infinite;
          animation-delay: ${Math.random() * 10}s;
        `;
        p.querySelector('svg').style.cssText = 'width:100%;height:100%;fill:' + color + ';';
      } else {
        p.style.cssText = `
          position: absolute;
          width: ${size}px;
          height: ${size}px;
          border-radius: 50%;
          background: ${color};
          left: 50%;
          top: 50%;
          opacity: 0;
          --dx: ${(Math.random() - 0.5) * 600}px;
          --dy: ${(Math.random() - 0.5) * 600}px;
          --rot: ${(Math.random() - 0.5) * 360}deg;
          animation: particleDrift ${Math.random() * 6 + 7}s linear infinite;
          animation-delay: ${Math.random() * 10}s;
        `;
      }

      container.appendChild(p);
    }

    for (let i = 0; i < particleCount; i++) {
      createParticle();
    }
  })();
</script>

<style is:global>
@keyframes particleDrift {
  0% { transform: translate(0, 0) scale(0.3) rotate(0deg); opacity: 0; }
  8% { opacity: 0.6; }
  50% { opacity: 0.25; }
  100% { transform: translate(var(--dx), var(--dy)) scale(1) rotate(var(--rot)); opacity: 0; }
}
</style>

---
import { config } from "../config";

const { name1, name2, startDate } = config;
---

<section id="hero" class="min-h-screen flex flex-col items-center justify-center relative px-4 overflow-hidden" style="background: radial-gradient(ellipse at 50% 40%, rgba(237,107,134,0.15) 0%, transparent 55%), radial-gradient(ellipse at 30% 80%, rgba(237,107,134,0.04) 0%, transparent 40%), linear-gradient(180deg, #FFF8F9 0%, #FFF3F5 100%);">
  <!-- 动态大爱心背景 -->
  <div class="absolute top-1/2 left-1/2 pointer-events-none z-0" style="transform: translate(-50%, -50%); width: 700px; height: 700px;">
    <!-- 心跳光晕层 -->
    <div class="absolute top-1/2 left-1/2 rounded-full" style="transform: translate(-50%, -50%); width: 120%; height: 120%; background: radial-gradient(circle, rgba(237,107,134,0.1) 0%, transparent 60%); animation: heartbeat 2.4s cubic-bezier(0.36, 0, 0.64, 1) infinite;"></div>
    <!-- 大爱心 - 心跳动画 -->
    <div class="absolute top-1/2 left-1/2" style="transform: translate(-50%, -50%); width: 100%; height: 100%;">
      <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: 100%; fill: #ED6B86; filter: blur(0.5px); opacity: 0.12; animation: heartbeat 2.4s cubic-bezier(0.36, 0, 0.64, 1) infinite;">
        <path d="M462.3 62.6C407.5 15.9 326 24.3 275.7 76.2L256 96.5l-19.7-20.3C186.1 24.3 104.5 15.9 49.7 62.6c-62.8 53.6-66.1 149.8-9.9 207.9l193.5 199.8c12.5 12.9 32.8 12.9 45.3 0l193.5-199.8c56.3-58.1 53-154.3-9.8-207.9z"/>
      </svg>
    </div>
  </div>

  <!-- 名字 -->
  <div class="text-center z-10 mb-4">
    <h1 class="text-4xl md:text-6xl font-normal text-[#2C1A1E] mb-0" style="font-family: 'Playfair Display', 'Noto Serif SC', serif; letter-spacing: 3px;">
      {name1} <span class="inline-block text-[#ED6B86] mx-4 animate-heartbeat" style="font-size: 1.2rem; vertical-align: middle;">♥</span> {name2}
    </h1>
  </div>

  <!-- 日期线 -->
  <div class="flex items-center gap-3 z-10 mb-10">
    <div class="w-1 h-1 rounded-full bg-[#F5A8B8]"></div>
    <span class="text-[#A0808A] text-xs tracking-[3px]" style="font-family: 'Playfair Display', serif;">{new Date(startDate).toLocaleDateString("zh-CN").replace(/\//g, '.')}</span>
    <div class="w-1 h-1 rounded-full bg-[#F5A8B8]"></div>
  </div>

  <!-- 计时器 -->
  <div id="timer-container" data-start-date={startDate} class="bg-white/80 backdrop-blur-[24px] rounded-[28px] px-14 py-11 text-center z-10 shadow-lg" style="border: 1px solid rgba(237,107,134,0.15); box-shadow: 0 12px 48px rgba(237,107,134,0.12); animation: cardFloat 8s ease-in-out infinite;">
    <p class="text-[#A0808A] text-xs tracking-[4px] mb-5 font-light uppercase">We Have Been Together</p>
    <div id="timer" class="text-5xl md:text-6xl font-normal text-[#2C1A1E] tracking-wide tabular-nums" style="font-family: 'Playfair Display', serif;">
      计算中...
    </div>
    <p class="text-[#C4A4AB] text-xs tracking-[3px] mt-5 uppercase" style="font-family: 'Playfair Display', serif;">And Counting</p>
  </div>

  <!-- 滚动提示 -->
  <div class="absolute bottom-8 flex flex-col items-center gap-2 z-10" style="animation: bounceSlow 3s ease-in-out infinite;">
    <div class="w-[1px] h-6 bg-gradient-to-b from-[#F5A8B8] to-transparent"></div>
  </div>
</section>

<script is:inline>
  // 恋爱计时器 - 每秒更新
  // 从 data-start-date 属性读取恋爱开始日期
  (function() {
    var container = document.getElementById("timer-container");
    if (!container) return;
    var startDateStr = container.getAttribute("data-start-date");
    var startDate = new Date(startDateStr + "T00:00:00").getTime();
    var timerEl = document.getElementById("timer");
    
    function updateTimer() {
      var now = Date.now();
      var diff = now - startDate;
      
      if (isNaN(startDate)) {
        timerEl.textContent = "日期解析错误";
        return;
      }
      
      var days = Math.floor(diff / (1000 * 60 * 60 * 24));
      var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var seconds = Math.floor((diff % (1000 * 60)) / 1000);
      
      if (timerEl) {
        timerEl.textContent = days + "\u5929 " + String(hours).padStart(2, '0') + "\u65f6 " + String(minutes).padStart(2, '0') + "\u5206 " + String(seconds).padStart(2, '0') + "\u79d2";
      }
    }
    
    updateTimer();
    var timer = setInterval(updateTimer, 1000);

    // Bug 9 修复：页面卸载时清除定时器，避免内存泄漏
    window.addEventListener("beforeunload", function() {
      clearInterval(timer);
    });
  })();
</script>

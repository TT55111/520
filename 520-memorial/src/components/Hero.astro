---
import { config } from "../config";
const { name1, name2, startDate } = config;
---

<section id="hero" class="min-h-screen flex flex-col items-center justify-center relative px-4 overflow-hidden" style="background: radial-gradient(ellipse at 50% 40%, rgba(237,107,134,0.10) 0%, transparent 55%), radial-gradient(ellipse at 30% 80%, rgba(237,107,134,0.03) 0%, transparent 40%), linear-gradient(180deg, #FFF8F9 0%, #FFF3F5 100%);">
  <!-- 名字 - shimmer 光效 -->
  <div class="text-center z-10 mb-4">
    <h1 class="text-4xl md:text-6xl font-normal mb-0" style="font-family: 'Playfair Display', 'Noto Serif SC', serif; letter-spacing: 4px; background: linear-gradient(120deg, #2C1A1E 0%, #2C1A1E 35%, #ED6B86 50%, #2C1A1E 65%, #2C1A1E 100%); background-size: 250% 100%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: shimmer 6s ease-in-out infinite;">
      {name1} <span class="inline-block mx-4 animate-heartbeat" style="font-size: 1rem; vertical-align: middle; -webkit-text-fill-color: #ED6B86;">♥</span> {name2}
    </h1>
  </div>

  <!-- 日期线 - 菱形分隔符+装饰线 -->
  <div class="flex items-center gap-3 z-10 mb-10">
    <div style="width: 24px; height: 1px; background: linear-gradient(to right, transparent, #F5A8B8, transparent);"></div>
    <div style="width: 4px; height: 4px; background: #F5A8B8; transform: rotate(45deg); flex-shrink: 0;"></div>
    <span class="text-[#A0808A] text-xs tracking-[3px]" style="font-family: 'Playfair Display', serif;">{new Date(startDate).toLocaleDateString("zh-CN").replace(/\//g, '.')}</span>
    <div style="width: 4px; height: 4px; background: #F5A8B8; transform: rotate(45deg); flex-shrink: 0;"></div>
    <div style="width: 24px; height: 1px; background: linear-gradient(to right, transparent, #F5A8B8, transparent);"></div>
  </div>

  <!-- 计时器 - 拆分单元 + 渐变边框 -->
  <div id="timer-container" data-start-date={startDate} class="relative z-10 rounded-[24px] px-12 py-10 text-center" style="background: linear-gradient(#FFF8F9, #FFF8F9) padding-box, linear-gradient(135deg, rgba(237,107,134,0.25), rgba(237,107,134,0.05), rgba(237,107,134,0.25)) border-box; border: 1.5px solid transparent; box-shadow: 0 2px 16px rgba(237,107,134,0.06), 0 1px 3px rgba(0,0,0,0.03); animation: cardFloat 8s ease-in-out infinite;">
    <div class="absolute inset-0 rounded-[24px] z-[-1]" style="background: rgba(255,255,255,0.75); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);"></div>
    <p class="text-[#A0808A] text-xs tracking-[4px] mb-5 font-light uppercase" style="font-family: 'Playfair Display', serif;">We Have Been Together</p>
    <div class="flex items-center justify-center gap-2">
      <div class="flex flex-col items-center min-w-[56px]">
        <span id="timer-days" class="text-4xl md:text-5xl font-normal text-[#2C1A1E] tracking-wide tabular-nums" style="font-family: 'Playfair Display', serif; line-height: 1.2;">0</span>
        <span class="text-[#C4A4AB] text-[0.625rem] tracking-[2px] uppercase mt-1" style="font-family: 'Playfair Display', serif;">Days</span>
      </div>
      <span class="text-xl md:text-2xl text-[#F5A8B8] -mt-2" style="animation: sepBlink 2s ease-in-out infinite; font-family: 'Playfair Display', serif;">:</span>
      <div class="flex flex-col items-center min-w-[56px]">
        <span id="timer-hours" class="text-4xl md:text-5xl font-normal text-[#2C1A1E] tracking-wide tabular-nums" style="font-family: 'Playfair Display', serif; line-height: 1.2;">00</span>
        <span class="text-[#C4A4AB] text-[0.625rem] tracking-[2px] uppercase mt-1" style="font-family: 'Playfair Display', serif;">Hours</span>
      </div>
      <span class="text-xl md:text-2xl text-[#F5A8B8] -mt-2" style="animation: sepBlink 2s ease-in-out infinite; font-family: 'Playfair Display', serif;">:</span>
      <div class="flex flex-col items-center min-w-[56px]">
        <span id="timer-mins" class="text-4xl md:text-5xl font-normal text-[#2C1A1E] tracking-wide tabular-nums" style="font-family: 'Playfair Display', serif; line-height: 1.2;">00</span>
        <span class="text-[#C4A4AB] text-[0.625rem] tracking-[2px] uppercase mt-1" style="font-family: 'Playfair Display', serif;">Mins</span>
      </div>
      <span class="text-xl md:text-2xl text-[#F5A8B8] -mt-2" style="animation: sepBlink 2s ease-in-out infinite; font-family: 'Playfair Display', serif;">:</span>
      <div class="flex flex-col items-center min-w-[56px]">
        <span id="timer-secs" class="text-4xl md:text-5xl font-normal text-[#2C1A1E] tracking-wide tabular-nums" style="font-family: 'Playfair Display', serif; line-height: 1.2;">00</span>
        <span class="text-[#C4A4AB] text-[0.625rem] tracking-[2px] uppercase mt-1" style="font-family: 'Playfair Display', serif;">Secs</span>
      </div>
    </div>
    <p class="text-[#C4A4AB] text-xs tracking-[3px] mt-5 uppercase" style="font-family: 'Playfair Display', serif;">And Counting</p>
  </div>

  <!-- 滚动提示 - 箭头+文字 -->
  <div class="absolute bottom-8 left-0 right-0 flex flex-col items-center gap-1.5 z-10" style="animation: bounceSlow 3s ease-in-out infinite;">
    <span class="text-[#C4A4AB] text-[0.625rem] tracking-[3px] uppercase">Scroll</span>
    <svg class="w-4 h-4" style="stroke: #F5A8B8; stroke-width: 1.5; fill: none;" viewBox="0 0 24 24">
      <path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</section>

<script is:inline>
  // 恋爱计时器 - 拆分为独立单元
  (function() {
    var container = document.getElementById("timer-container");
    if (!container) return;
    var startDateStr = container.getAttribute("data-start-date");
    var startDate = new Date(startDateStr + "T00:00:00").getTime();
    var daysEl = document.getElementById("timer-days");
    var hoursEl = document.getElementById("timer-hours");
    var minsEl = document.getElementById("timer-mins");
    var secsEl = document.getElementById("timer-secs");

    function updateTimer() {
      var diff = Date.now() - startDate;
      if (isNaN(startDate)) return;
      var days = Math.floor(diff / (1000 * 60 * 60 * 24));
      var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var seconds = Math.floor((diff % (1000 * 60)) / 1000);
      if (daysEl) daysEl.textContent = days;
      if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
      if (minsEl) minsEl.textContent = String(minutes).padStart(2, '0');
      if (secsEl) secsEl.textContent = String(seconds).padStart(2, '0');
    }

    updateTimer();
    var timer = setInterval(updateTimer, 1000);
    window.addEventListener("beforeunload", function() { clearInterval(timer); });
  })();
</script>

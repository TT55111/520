---
/**
 * 照片预览 Modal
 * 点击照片后放大展示，支持 ESC 关闭、点击外部关闭
 * 优化：添加淡入 + 缩放动画
 */
---

<!-- CSS 动画类 -->
<style>
  .modal-enter-active {
    animation: modalFadeIn 0.25s ease-out forwards;
  }
  .modal-content-enter-active {
    animation: modalScaleIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .modal-exit-active {
    animation: modalFadeOut 0.2s ease-in forwards;
  }
  .modal-content-exit-active {
    animation: modalScaleOut 0.2s ease-in forwards;
  }
  @keyframes modalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes modalFadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  @keyframes modalScaleIn {
    from { transform: scale(0.92); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  @keyframes modalScaleOut {
    from { transform: scale(1); opacity: 1; }
    to { transform: scale(0.92); opacity: 0; }
  }
</style>

<div
  id="photo-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-5"
  onclick="window.Love520.closePhotoModal(event)"
  style="background: rgba(44,26,30,0.85); backdrop-filter: blur(8px);"
>
  <div class="relative max-w-[90vw] max-h-[85vh] rounded-[16px] overflow-hidden" style="box-shadow: 0 20px 60px rgba(0,0,0,0.3);" onclick="event.stopPropagation()">
    <button
      onclick="window.Love520.closePhotoModal()"
      class="absolute top-3 right-3 bg-white/90 rounded-full w-9 h-9 flex items-center justify-center z-10 hover:scale-110 transition-transform"
      aria-label="关闭预览"
    >
      <svg class="w-4 h-4" style="stroke: #D4507A; stroke-width: 2; fill: none;" viewBox="0 0 24 24">
        <path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <img
      id="modal-image"
      src=""
      alt="照片预览"
      class="max-w-full max-h-[85vh] object-contain block"
    />
  </div>
</div>
